dist~/*

/Diagnostics/Benchmark/Results/*
/Diagnostics/Logs/Results/*
# The legacy in-package results folders above are ignored, so fresh clones and
# store installs never have them -- their folder .metas were deleted as orphans
# (post-rename audit). On machines still holding pre-0.13.0 runs Unity keeps
# regenerating the folder .meta; ignore it so it cannot sneak back in.
/Diagnostics/Benchmark/Results.meta
/Diagnostics/Logs/Results.meta

/.vscode/*

ReactiveUIToolkitDocs~/**/*.meta
ReactiveUIToolkitDocs~/dist/*
ReactiveUIToolkitDocs~/node_modules/*

# ── Source generator ────────────────────────────────────────────
# The compiled DLL in Analyzers/ IS committed;
# only the intermediate build output dirs and side-files are ignored.
SourceGenerator~/obj/
SourceGenerator~/bin/
SourceGenerator~/Tests/obj/
SourceGenerator~/Tests/bin/
# Tools/ was not covered, so RuitkMigrateBrand's build output was committed and
# published on the dist branch (artifacts embed the maintainer's absolute paths).
# Each tool also carries its own .gitignore; this is the belt-and-braces catch-all.
SourceGenerator~/Tools/*/obj/
SourceGenerator~/Tools/*/bin/

# ── Analyzers (distributed DLLs) ───────────────────────────────
# PDBs, deps.json, and their Unity .meta companions are not needed
Analyzers/*.deps.json
Analyzers/*.deps.json.meta
Analyzers/*.pdb
Analyzers/*.pdb.meta
Analyzers/publish/
Analyzers/publish.meta

# ── VSIX build artifacts (all IDEs) ────────────────────────────
# Never commit .vsix files anywhere in the repo
**/*.vsix
UitkxVsix.vsix.meta

# ── Visual Studio IDE cache ────────────────────────────────────
.vs/
ide-extensions~/visual-studio/UitkxVsix/.vs/

# VS2022 extension build artifacts
ide-extensions~/visual-studio/UitkxVsix/bin/
ide-extensions~/visual-studio/UitkxVsix/obj/
ide-extensions~/visual-studio/UitkxVsix/server/
ide-extensions~/visual-studio/UitkxVsix/_inspect_*/

# VS Code extension build artifacts
ide-extensions~/vscode/server/
ide-extensions~/vscode/node_modules/
ide-extensions~/vscode/CHANGELOG.md

# VS2022 marketplace overview (generated from centralized changelog)
ide-extensions~/visual-studio/UitkxVsix/overview.md
ide-extensions~/visual-studio/CHANGELOG.md

# LSP server build artifacts
ide-extensions~/lsp-server/bin/
ide-extensions~/lsp-server/obj/
ide-extensions~/lsp-server/publish/

# Language lib build artifacts
ide-extensions~/language-lib/bin/
ide-extensions~/language-lib/obj/

# ── AstDump ad-hoc tool ────────────────────────────────────────
# Local-only Roslyn-AST inspection helper. Not used by
# unity-api-diff.ps1, the package, IDE extensions, HMR, or CI.
# The whole folder is ignored — recreate Program.cs + AstDump.csproj
# locally if you need it (or use automation~/dump_ast.csx instead).
automation~/AstDump/

# ── UITKX recompile triggers (generated by UitkxChangeWatcher) ─
# Tiny .cs files written into each assembly that has .uitkx files, to force a
# fast incremental recompile on save so the source generator re-reads them.
# Regenerated at runtime; never commit.
**/UITKX_GeneratorTrigger.g.cs
**/UITKX_GeneratorTrigger.g.cs.meta
**/UITKX_GeneratorTrigger.cs
**/UITKX_GeneratorTrigger.cs.meta

# ── Temporary debugging scripts ────────────────────────────────
*.csx
!SourceGenerator~/Tests/FormatTest.csx

# ── Credentials / machine-local — never commit ─────────────────
publisher-secrets.json
publisher-secrets.json.meta
# This machine's irreducible tool paths (npm, optionally the Unity editor).
# Copy .ruitk-local.example.json to create it. No tracked file may name a path
# that exists only on one machine -- see CLAUDE.md "Machine-local paths",
# enforced by scripts/check-machine-paths.mjs.
.ruitk-local.json

# ── Stale/orphan entries ───────────────────────────────────────
# NOTE: Resources/__uitkx_registry.asset is intentionally NOT ignored.
# It must be committed because builds require it (no Editor to regenerate).
# The file is small (~50 bytes per asset entry) and auto-maintained by
# UitkxAssetRegistrySync on domain reload and .uitkx save.
_docs_branch/
_docs_branch.meta

DiabloMenuDemo/
DiabloMenuDemo.meta
DiabloMenuDemoFunc/
DiabloMenuDemoFunc.meta
ide-extensions~/.language-editor-variant/
