export VirtualNode PanelNestedChildFunc() {
  var (count, setCount) = useState(0);

  var cardStyle = new Style {
    (StyleKeys.Padding, 12f),
    (StyleKeys.FlexDirection, "column"),
    (StyleKeys.BackgroundColor, new Color32(34, 44, 30, 240)),
    (StyleKeys.BorderRadius, 8f),
  };

  var noteStyle = new Style { WhiteSpace = WsNormal };

  return (
    <VisualElement style={cardStyle}>
      <Text text="NESTED child PanelRenderer" />
      <Label
        text="This counter is local hook state. It survives a retarget; after a repair-and-remount (the tree was released, nothing was salvageable) it restarts at 0 - that reset is how you can SEE the repair happened."
        style={noteStyle}
      />
      <Text text={$"Child counter: {count}"} />
      <Button text="+1" onClick={_ => setCount(count + 1)} />
    </VisualElement>
  );
}
