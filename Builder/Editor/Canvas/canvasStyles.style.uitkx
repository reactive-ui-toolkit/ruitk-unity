export Style Root = new Style {
  FlexGrow = 1,
  Overflow = OverflowHidden,
  BackgroundColor = Hex("#1b1b1f"),
};

export Style DotGrid = new Style {
  Position = PosAbsolute,
  Top = Px(0),
  Left = Px(0),
  Right = Px(0),
  Bottom = Px(0),
};

export Style EdgeLayer = new Style {
  Position = PosAbsolute,
  Top = Px(0),
  Left = Px(0),
  Width = Px(1),
  Height = Px(1),
};

export Style CardHeader = new Style {
  FlexDirection = FlexRow,
  AlignItems = AlignCenter,
  PaddingLeft = Px(12),
  PaddingRight = Px(12),
  PaddingTop = Px(8),
  PaddingBottom = Px(8),
  BackgroundColor = Hex("#2a2a31"),
  // The POC rule is 1px, scaled by the live zoom like everything else on the
  // canvas. 1.5px was a compensation for UITK dimming a hairline, but measured
  // against poc-l2-edit.png it overshoots: the POC lays down ~1.4 device px of
  // ink at the L2 zoom and 1.5f snapped to 2 solid px. The authored POC width is
  // the geometrically exact value (1 * zoom == the browser's own coverage).
  BorderBottomWidth = 1f,
  BorderBottomColor = Hex("#3a3a44"),
  BorderTopLeftRadius = Px(9),
  BorderTopRightRadius = Px(9),
};

export Style CardPill = new Style {
  FlexDirection = FlexRow,
  AlignItems = AlignCenter,
  PaddingLeft = Px(20),
  PaddingRight = Px(20),
  PaddingTop = Px(16),
  PaddingBottom = Px(16),
};

// POC "font: 13px/1.45" cascades a 1.45 LINE BOX onto every card row. UI Toolkit
// Labels have no line-height property and lay out at the font's own line box, so
// every row came out 15-20% short and the cards read tighter than the POC's.
// Each single-line row carries its 1.45x box as an explicit height with the text
// centred in it, which is what a CSS line box does.
export Style CardTitle = new Style {
  Color = Hex("#d6d6dc"),
  FontSize = Px(14),
  Height = Px(20.3f),
  TextAlign = TextMiddleLeft,
  UnityFontStyle = FontBold,
  FlexGrow = 1,
};

export Style CardKindLabel = new Style {
  Color = Hex("#8b8b96"),
  FontSize = Px(9),
};

export Style CardLock = new Style {
  Color = Hex("#c9a25a"),
  FontSize = Px(9),
  MarginLeft = Px(4),
};

export Style CardBody = new Style {
  FlexShrink = 0,
};

export Style CardSection = new Style {
  PaddingLeft = Px(12),
  PaddingRight = Px(12),
  PaddingTop = Px(7),
  PaddingBottom = Px(7),
  // POC "rgba(58,58,68,.6)" over the #232329 card composites to #313139, painted
  // here at full alpha so the width alone carries the weight. 1px is the POC's
  // own rule width; 1.5f put a second solid device px of ink under every section.
  BorderBottomWidth = 1f,
  BorderBottomColor = Hex("#313139"),
};

export Style CardSectionLast = new Style {
  PaddingLeft = Px(12),
  PaddingRight = Px(12),
  PaddingTop = Px(7),
  PaddingBottom = Px(7),
};

export Style CardSignature = new Style {
  Color = Hex("#8b8b96"),
  FontSize = Px(12),
  Height = Px(17.4f),
  TextAlign = TextMiddleLeft,
  UnityFontDefinition = Ruitk.Builder.BuilderCanvasDrawing.MonoFontDefinition,
};

export Style CardSectionHeader = new Style {
  Color = Hex("#8b8b96"),
  FontSize = Px(10),
  Height = Px(14.5f),
  TextAlign = TextMiddleLeft,
  LetterSpacing = Px(1),
  MarginBottom = Px(5),
};

export Style CardImportLine = new Style {
  Color = Hex("#8b8b96"),
  FontSize = Px(11.5f),
  Height = Px(16.7f),
  // A flex item's "min-height: auto" is its min-content height, which for the
  // mono face is TALLER than the declared 1.45 box — so the auto minimum won and
  // the row measured ~20.7 instead of 19.7 (measured drift: ~7px over six rows).
  MinHeight = Px(0),
  TextAlign = TextMiddleLeft,
  UnityFontDefinition = Ruitk.Builder.BuilderCanvasDrawing.MonoFontDefinition,
  FlexGrow = 1,
  FlexShrink = 1,
  Overflow = OverflowHidden,
  WhiteSpace = WsNowrap,
  TextOverflow = TextEllipsis,
};

// POC jsxRowHtml concatenates the attribute name, the '=' and the expr span with
// NOTHING between them. Composed out of sibling Labels the inherited box spacing
// showed up as a space after every '=' and inside every brace pair, so the four
// pieces of an attribute carry no margin or padding of their own; only the
// per-attribute wrapper keeps the POC's ".attr" 6px right margin.
export Style AttrName = new Style {
  Color = Hex("#9d9dab"),
  FontSize = Px(12),
  Height = Px(17.4f),
  MinHeight = Px(0),
  TextAlign = TextMiddleLeft,
  MarginLeft = Px(0),
  MarginRight = Px(0),
  PaddingLeft = Px(0),
  PaddingRight = Px(0),
  UnityFontDefinition = Ruitk.Builder.BuilderCanvasDrawing.MonoFontDefinition,
};

export Style AttrBrace = new Style {
  Color = Hex("#ffb74d"),
  FontSize = Px(12),
  Height = Px(17.4f),
  MinHeight = Px(0),
  TextAlign = TextMiddleLeft,
  MarginLeft = Px(0),
  MarginRight = Px(0),
  PaddingLeft = Px(0),
  PaddingRight = Px(0),
  UnityFontDefinition = Ruitk.Builder.BuilderCanvasDrawing.MonoFontDefinition,
};

