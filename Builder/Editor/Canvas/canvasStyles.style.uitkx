export Style CodeIsland = new Style {
  BackgroundColor = Hex("#17171b"),
  BorderRadius = Px(6),
  BorderTopWidth = 1,
  BorderRightWidth = 1,
  BorderBottomWidth = 1,
  BorderLeftWidth = 1,
  BorderTopColor = Hex("#3a3a44"),
  BorderRightColor = Hex("#3a3a44"),
  BorderBottomColor = Hex("#3a3a44"),
  BorderLeftColor = Hex("#3a3a44"),
  PaddingLeft = Px(9),
  PaddingRight = Px(9),
  PaddingTop = Px(6),
  PaddingBottom = Px(6),
};

export Style CodeIslandLine = new Style {
  Color = Hex("#bdbdc7"),
  FontSize = Px(11.5f),
  // POC ".code-island" inherits the body's 1.45 line box at font-size 11.5 →
  // 16.7px rows (poc-l2-edit.png: 18 CSS px between island lines at zoom 1.25).
  // Every other code-bearing row style already carries its line box; this one
  // did not, so the island read ~30% tighter than the POC's.
  Height = Px(16.7f),
  TextAlign = TextMiddleLeft,
  WhiteSpace = WsPre,
  UnityFontDefinition = Ruitk.Builder.BuilderCanvasDrawing.MonoFontDefinition,
};

// POC ".code-island:hover { border-color: var(--accent) }" — the island is an
// editable surface, so hovering it says so.
export Style CodeIslandHover = new Style {
  BackgroundColor = Hex("#17171b"),
  BorderRadius = Px(6),
  BorderTopWidth = 1,
  BorderRightWidth = 1,
  BorderBottomWidth = 1,
  BorderLeftWidth = 1,
  BorderTopColor = Hex("#4fc3f7"),
  BorderRightColor = Hex("#4fc3f7"),
  BorderBottomColor = Hex("#4fc3f7"),
  BorderLeftColor = Hex("#4fc3f7"),
  PaddingLeft = Px(9),
  PaddingRight = Px(9),
  PaddingTop = Px(6),
  PaddingBottom = Px(6),
};

// POC ".code-island.hl" — a code island whose text names a traced hook state.
export Style CodeIslandTrace = new Style {
  BackgroundColor = Hex("#221d12"),
  BorderRadius = Px(6),
  BorderTopWidth = 1,
  BorderRightWidth = 1,
  BorderBottomWidth = 1,
  BorderLeftWidth = 1,
  BorderTopColor = Rgba(255, 183, 77, 153),
  BorderRightColor = Rgba(255, 183, 77, 153),
  BorderBottomColor = Rgba(255, 183, 77, 153),
  BorderLeftColor = Rgba(255, 183, 77, 153),
  PaddingLeft = Px(9),
  PaddingRight = Px(9),
  PaddingTop = Px(6),
  PaddingBottom = Px(6),
};

// POC ".card.selected" adds "0 0 0 2px rgba(255,213,79,.25)" WITHOUT changing the
// border width — a spread shadow, which sits OUTSIDE the border. Painted inset it
// landed under the solid gold border and was invisible, so the ring is offset by
// its own 2px and lives outside the card frame (which clips its children).
export Style SelectionRing = new Style {
  Position = PosAbsolute,
  Top = Px(-2),
  Left = Px(-2),
  Right = Px(-2),
  Bottom = Px(-2),
  BorderRadius = Px(11),
  BorderTopWidth = 2,
  BorderRightWidth = 2,
  BorderBottomWidth = 2,
  BorderLeftWidth = 2,
  BorderTopColor = Rgba(255, 213, 79, 64),
  BorderRightColor = Rgba(255, 213, 79, 64),
  BorderBottomColor = Rgba(255, 213, 79, 64),
  BorderLeftColor = Rgba(255, 213, 79, 64),
};

// POC ".drop-hint": 2px dashed accent outline + rgba(79,195,247,.08) fill on
// the card/section a payload would land on (UITK has no dashed border — the
// closest equivalent is the solid accent ring with the same tint).
export Style CardDropHint = new Style {
  Position = PosAbsolute,
  Top = Px(0),
  Left = Px(0),
  Right = Px(0),
  Bottom = Px(0),
  BorderRadius = Px(9),
  BackgroundColor = Rgba(79, 195, 247, 20),
  BorderTopWidth = 2,
  BorderRightWidth = 2,
  BorderBottomWidth = 2,
  BorderLeftWidth = 2,
  BorderTopColor = Hex("#4fc3f7"),
  BorderRightColor = Hex("#4fc3f7"),
  BorderBottomColor = Hex("#4fc3f7"),
  BorderLeftColor = Hex("#4fc3f7"),
};

// POC ".card { box-shadow: 0 6px 18px rgba(0,0,0,.35) }" — an 18px BLUR around a
// shadow box offset 6px down, so the dark reaches 18px past that box on every
// side and fades CONTINUOUSLY (probed on poc-l2-edit.png: 24 monotone rows below
// the card, no two the same). UITK has no box-shadow, and four stacked opaque
// rects read as four flat plateaus with visible steps between them. One layer
// carries the whole falloff now, painted as a Gaussian ramp by
// BuilderCanvasDrawing.DrawCardShadow. The insets below ARE the blur reach: the
// element's content rect is the shadow box grown by 18 on all four sides, which
// is the geometry the painter assumes.
export Style CardShadowLayer = new Style {
  Position = PosAbsolute,
  Top = Px(-12),
  Left = Px(-18),
  Right = Px(-18),
  Bottom = Px(-24),
};

