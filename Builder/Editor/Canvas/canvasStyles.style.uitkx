// POC ".code-island.hl" — a code island whose text names a traced hook state.
export Style CodeIslandTrace = new Style {
  BackgroundColor = Hex("#221d12"),
  BorderRadius = Px(6),
  BorderTopWidth = 1,
  BorderRightWidth = 1,
  BorderBottomWidth = 1,
  BorderLeftWidth = 1,
  BorderTopColor = Rgba(255, 183, 77, 153),
  BorderRightColor = Rgba(255, 183, 77, 153),
  BorderBottomColor = Rgba(255, 183, 77, 153),
  BorderLeftColor = Rgba(255, 183, 77, 153),
  PaddingLeft = Px(9),
  PaddingRight = Px(9),
  PaddingTop = Px(6),
  PaddingBottom = Px(6),
};

// POC ".card.selected" adds "0 0 0 2px rgba(255,213,79,.25)" WITHOUT changing the
// border width — a spread shadow, which sits OUTSIDE the border. Painted inset it
// landed under the solid gold border and was invisible, so the ring is offset by
// its own 2px and lives outside the card frame (which clips its children).
export Style SelectionRing = new Style {
  Position = PosAbsolute,
  Top = Px(-2),
  Left = Px(-2),
  Right = Px(-2),
  Bottom = Px(-2),
  BorderRadius = Px(11),
  BorderTopWidth = 2,
  BorderRightWidth = 2,
  BorderBottomWidth = 2,
  BorderLeftWidth = 2,
  BorderTopColor = Rgba(255, 213, 79, 64),
  BorderRightColor = Rgba(255, 213, 79, 64),
  BorderBottomColor = Rgba(255, 213, 79, 64),
  BorderLeftColor = Rgba(255, 213, 79, 64),
};

// POC ".drop-hint": 2px dashed accent outline + rgba(79,195,247,.08) fill on
// the card/section a payload would land on (UITK has no dashed border — the
// closest equivalent is the solid accent ring with the same tint).
export Style CardDropHint = new Style {
  Position = PosAbsolute,
  Top = Px(0),
  Left = Px(0),
  Right = Px(0),
  Bottom = Px(0),
  BorderRadius = Px(9),
  BackgroundColor = Rgba(79, 195, 247, 20),
  BorderTopWidth = 2,
  BorderRightWidth = 2,
  BorderBottomWidth = 2,
  BorderLeftWidth = 2,
  BorderTopColor = Hex("#4fc3f7"),
  BorderRightColor = Hex("#4fc3f7"),
  BorderBottomColor = Hex("#4fc3f7"),
  BorderLeftColor = Hex("#4fc3f7"),
};

// POC ".card { box-shadow: 0 6px 18px rgba(0,0,0,.35) }" — an 18px BLUR, so the
// dark spreads ~9px to each side and ~15px below and fades out. UITK has no
// box-shadow; a single offset rect gave a hard 4px band under the card and
// nothing at all at its sides. Four concentric rects of growing inset and
// falling alpha composite to ~.32 at the card edge with a real falloff.
export Style CardShadowFar = new Style {
  Position = PosAbsolute,
  Top = Px(-3),
  Left = Px(-9),
  Right = Px(-9),
  Bottom = Px(-15),
  BorderRadius = Px(19),
  BackgroundColor = Rgba(0, 0, 0, 26),
};

export Style CardShadowMid = new Style {
  Position = PosAbsolute,
