  Height = Px(17.4f),
  TextAlign = TextMiddleLeft,
  UnityFontDefinition = Ruitk.Builder.BuilderCanvasDrawing.MonoFontDefinition,
};

export Style CardSectionHeader = new Style {
  Color = Hex("#8b8b96"),
  FontSize = Px(10),
  Height = Px(14.5f),
  TextAlign = TextMiddleLeft,
  LetterSpacing = Px(1),
  MarginBottom = Px(5),
};

export Style CardImportLine = new Style {
  Color = Hex("#8b8b96"),
  FontSize = Px(11.5f),
  Height = Px(16.7f),
  TextAlign = TextMiddleLeft,
  UnityFontDefinition = Ruitk.Builder.BuilderCanvasDrawing.MonoFontDefinition,
  FlexGrow = 1,
  FlexShrink = 1,
  Overflow = OverflowHidden,
  WhiteSpace = WsNowrap,
  TextOverflow = TextEllipsis,
};

// POC jsxRowHtml concatenates the attribute name, the '=' and the expr span with
// NOTHING between them. Composed out of sibling Labels the inherited box spacing
// showed up as a space after every '=' and inside every brace pair, so the four
// pieces of an attribute carry no margin or padding of their own; only the
// per-attribute wrapper keeps the POC's ".attr" 6px right margin.
export Style AttrName = new Style {
  Color = Hex("#9d9dab"),
  FontSize = Px(12),
  Height = Px(17.4f),
  TextAlign = TextMiddleLeft,
  MarginLeft = Px(0),
  MarginRight = Px(0),
  PaddingLeft = Px(0),
  PaddingRight = Px(0),
  UnityFontDefinition = Ruitk.Builder.BuilderCanvasDrawing.MonoFontDefinition,
};

export Style AttrBrace = new Style {
  Color = Hex("#ffb74d"),
  FontSize = Px(12),
  Height = Px(17.4f),
  TextAlign = TextMiddleLeft,
  MarginLeft = Px(0),
  MarginRight = Px(0),
  PaddingLeft = Px(0),
  PaddingRight = Px(0),
  UnityFontDefinition = Ruitk.Builder.BuilderCanvasDrawing.MonoFontDefinition,
};

