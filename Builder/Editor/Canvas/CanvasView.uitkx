import * as CanvasStyles from "./canvasStyles.style"
import "@UnityEngine.UIElements"
import "@Ruitk.Builder"

export VirtualNode CanvasView(
  BuilderGraph graph,
  float initialCamX = 0f,
  float initialCamY = 0f,
  float initialZoom = 1f,
  Action<string> onOpenFile = null,
  Action onLayoutChanged = null,
  Action<int> onSelect = null,
  Action<float, float, float> onCameraChanged = null,
  Action<int> onCardContext = null,
  Action<string, int> onRowClick = null,
  Action<string, int, int> onRowContext = null,
  Action onCanvasContext = null,
  Action<string, int, int, string> onRowDrop = null,
  Action<string, string, int> onStyleAddEntry = null,
  Action<string> onAddHook = null,
  Action<string> onRowNavigate = null,
  Action<string, int, int, string> onAttrValueEdit = null,
  Action<string, int, string> onDirectiveEdit = null,
  Action<string, int, string> onLineRewrite = null,
  Action<string, int, int, string> onIslandEdit = null,
  Action<string> onAddStyleExport = null,
  Action<string> onAddUtilExport = null,
  float viewZoom = 0f,
  float viewCamX = 0f,
  float viewCamY = 0f,
  int viewVersion = 0
) {
  var (camX, setCamX) = useState(initialCamX);
  var (camY, setCamY) = useState(initialCamY);
  var (zoom, setZoom) = useState(initialZoom);
  var (selected, setSelected) = useState(-1);
  var (selRowNode, setSelRowNode) = useState(-1);
  var (selRowIdx, setSelRowIdx) = useState(-1);
  var (traceStates, setTraceStates) = useState((string)null);
  var (dragRowKey, setDragRowKey) = useState(-1);
  var (hoverRowKey, setHoverRowKey) = useState(-1);
  var (dragBand, setDragBand) = useState(1);
  var (editKey, setEditKey) = useState("");
  var (editText, setEditText) = useState("");
  var (layoutVersion, setLayoutVersion) = useState(0);

  var panning = useRef(false);
  var dragCard = useRef(-1);
  var lastX = useRef(0f);
  var lastY = useRef(0f);
  var appliedView = useRef(viewVersion);

  if (appliedView.Current != viewVersion) {
    appliedView.Current = viewVersion;
    setZoom(viewZoom);
    setCamX(viewCamX);
    setCamY(viewCamY);
    zoom = viewZoom;
    camX = viewCamX;
    camY = viewCamY;
  }

  int lod = zoom < 0.45f ? 0 : (zoom < 1.05f ? 1 : 2);
  bool lodFull = lod >= 1;
  BuilderCanvasDrawing.CurrentLod = lod;
  float cardWidth = BuilderCanvasDrawing.CardWidthFor(lod);

  return (
    <VisualElement
      style={CanvasStyles.Root}
      onPointerDown={e => {
        if (e.Button == 1) {
          if (onCanvasContext != null) {
            onCanvasContext();
          }
          return;
        }
        if (dragCard.Current < 0) {
          panning.Current = true;
          lastX.Current = e.Position.x;
          lastY.Current = e.Position.y;
        }
      }}
      onPointerUp={e => {
        BuilderDragService.Cancel();
        if (dragRowKey >= 0) {
          setDragRowKey(-1);
        }
        if (panning.Current && onCameraChanged != null) {
          onCameraChanged(camX, camY, zoom);
        }
        panning.Current = false;
        if (dragCard.Current >= 0) {
          dragCard.Current = -1;
          if (onLayoutChanged != null) {
            onLayoutChanged();
          }
        }
      }}
      onPointerLeave={e => {
        panning.Current = false;
        if (dragCard.Current >= 0) {
          dragCard.Current = -1;
          if (onLayoutChanged != null) {
            onLayoutChanged();
          }
        }
      }}
      onPointerMove={e => {
        if (dragCard.Current >= 0) {
          var node = graph.Nodes[dragCard.Current];
          node.X = node.X + (e.Position.x - lastX.Current) / zoom;
          node.Y = node.Y + (e.Position.y - lastY.Current) / zoom;
          lastX.Current = e.Position.x;
          lastY.Current = e.Position.y;
          setLayoutVersion(layoutVersion + 1);
        } else if (panning.Current) {
          setCamX(camX + (e.Position.x - lastX.Current));
          setCamY(camY + (e.Position.y - lastY.Current));
          lastX.Current = e.Position.x;
          lastY.Current = e.Position.y;
        }
      }}
      onWheel={e => {
        float factor = e.Delta.y < 0f ? 1.12f : 1f / 1.12f;
        float next = Mathf.Clamp(zoom * factor, 0.18f, 2.2f);
        if (next != zoom) {
          float scale = next / zoom;
          float nx = e.Position.x - (e.Position.x - camX) * scale;
          float ny = e.Position.y - (e.Position.y - camY) * scale;
          setCamX(nx);
          setCamY(ny);
          setZoom(next);
          if (onCameraChanged != null) {
            onCameraChanged(nx, ny, next);
          }
        }
      }}
    >
      <VisualElement
        style={CanvasStyles.DotGrid}
        pickingMode={PickIgnore}
        onGenerateVisualContent={ctx => BuilderCanvasDrawing.DrawDotGrid(ctx)}
      />
      <VisualElement
        style={new Style {
          Position = PosAbsolute,
          Top = Px(0),
          Left = Px(0),
          Translate = Xlate(Px(camX), Px(camY)),
          Scale = new UnityEngine.UIElements.Scale(new Vector2(zoom, zoom)),
        }}
      >
        <VisualElement
          style={CanvasStyles.EdgeLayer}
          pickingMode={PickIgnore}
          onGenerateVisualContent={ctx => BuilderCanvasDrawing.DrawEdges(ctx, graph)}
          redrawKey={layoutVersion * 8 + lod}
        />
        @for (int i = 0; i < graph.Nodes.Count; i++) {
          var node = graph.Nodes[i];
          int index = i;
          bool isSelected = selected == index;
          return (
            <VisualElement
              key={node.FilePath}
              style={new Style {
                Position = PosAbsolute,
                Width = Px(cardWidth),
                Translate = Xlate(Px(node.X), Px(node.Y)),
                BackgroundColor = Hex("#232329"),
                BorderRadius = Px(10),
                BorderTopWidth = isSelected ? 2f : 1.5f,
                BorderRightWidth = isSelected ? 2f : 1.5f,
                BorderBottomWidth = isSelected ? 2f : 1.5f,
                BorderLeftWidth = isSelected ? 2f : 1.5f,
                BorderTopColor = isSelected ? Hex("#ffd54f") : Hex("#3a3a44"),
                BorderRightColor = isSelected ? Hex("#ffd54f") : Hex("#3a3a44"),
                BorderBottomColor = isSelected ? Hex("#ffd54f") : Hex("#3a3a44"),
                BorderLeftColor = isSelected ? Hex("#ffd54f") : Hex("#3a3a44"),
              }}
              onPointerDown={e => {
                if (e.Button == 1) {
                  if (onCardContext != null) {
                    onCardContext(index);
                  }
                  e.StopPropagation();
                  return;
                }
                if (e.ClickCount >= 2) {
                  if (onOpenFile != null) {
                    onOpenFile(node.FilePath);
                  }
                  e.StopPropagation();
                  return;
                }
                setSelected(index);
                if (onSelect != null) {
                  onSelect(index);
                }
                e.StopPropagation();
              }}
            >
              @if (lod == 0) {
                return (
                  <VisualElement
                    style={CanvasStyles.CardPill}
                    onPointerDown={e => {
                      if (e.Button == 0 && e.ClickCount < 2) {
                        dragCard.Current = index;
                        lastX.Current = e.Position.x;
                        lastY.Current = e.Position.y;
                        setSelected(index);
                      }
                    }}
                  >
                    <Label
                      text={BuilderCanvasDrawing.KindLabel(node.Kind)}
                      style={new Style {
                        FontSize = Px(15),
                        UnityFontStyle = FontBold,
                        Color = BuilderCanvasDrawing.KindColor(node.Kind),
                        BackgroundColor = BuilderCanvasDrawing.KindBadgeBg(node.Kind),
                        BorderRadius = Px(12),
                        PaddingLeft = Px(12),
                        PaddingRight = Px(12),
                        PaddingTop = Px(3),
                        PaddingBottom = Px(3),
                        MarginRight = Px(12),
                      }}
                    />
                    <Label
                      text={node.Title}
                      style={new Style {
                        FontSize = Px(26),
                        UnityFontStyle = FontBold,
                        Color = Hex("#d6d6dc"),
                        FlexGrow = 1,
                      }}
                    />
                  </VisualElement>
                );
              }
              @if (lod >= 1) {
                return (
                  <VisualElement
                    style={CanvasStyles.CardHeader}
                    onPointerDown={e => {
                      if (e.Button == 0 && e.ClickCount < 2) {
                        dragCard.Current = index;
                        lastX.Current = e.Position.x;
                        lastY.Current = e.Position.y;
                        setSelected(index);
                      }
                    }}
                  >
                    <Label
                      text={BuilderCanvasDrawing.KindLabel(node.Kind)}
                      style={new Style {
                        FontSize = Px(10),
                        UnityFontStyle = FontBold,
                        Color = BuilderCanvasDrawing.KindColor(node.Kind),
                        BackgroundColor = BuilderCanvasDrawing.KindBadgeBg(node.Kind),
                        BorderRadius = Px(8),
                        PaddingLeft = Px(7),
                        PaddingRight = Px(7),
                        PaddingTop = Px(1),
                        PaddingBottom = Px(1),
                        MarginRight = Px(8),
                      }}
                    />
                    <Label text={node.Title} style={CanvasStyles.CardTitle} />
                    @if (node.IsReadOnly) {
                      return (
                        <Label text="read-only" style={CanvasStyles.CardLock} />
                      );
                    }
                  </VisualElement>
                );
              }
              @if (lod >= 1 && node.Signature != null && node.Signature.Length > 0) {
                return (
                  <VisualElement style={CanvasStyles.CardSection}>
                    <Label
                      text={BuilderCanvasDrawing.SignatureRichText(node.Signature)}
                      enableRichText={true}
                      style={CanvasStyles.CardSignature}
                    />
                  </VisualElement>
                );
              }
              @if (lodFull) {
                return (
                  <VisualElement style={CanvasStyles.CardBody}>
                    @if (node.Imports.Count > 0) {
                      return (
                        <VisualElement style={CanvasStyles.CardSection}>
                          <Label text="IMPORTS" style={CanvasStyles.CardSectionHeader} />
                          @for (int x = 0; x < node.Imports.Count; x++) {
                            var imp = node.Imports[x];
                            return (
                              <VisualElement
                                key={$"imp-{x}"}
                                style={new Style {
                                  FlexDirection = FlexRow,
                                  AlignItems = AlignCenter,
                                  PaddingTop = Px(1),
                                  PaddingBottom = Px(1),
                                }}
                              >
                                <Label
                                  text={imp.Text}
                                  style={CanvasStyles.CardImportLine}
                                />
                                <VisualElement
                                  style={new Style {
                                    Width = Px(8),
                                    Height = Px(8),
                                    BorderRadius = Px(4),
                                    BackgroundColor = BuilderCanvasDrawing.DotColor(imp.BadgeKind),
                                    MarginLeft = Px(6),
                                    FlexShrink = 0,
                                  }}
                                />
                              </VisualElement>
                            );
                          }
                        </VisualElement>
                      );
                    }
                    @if (node.Body.Count > 0 || node.Kind == BuilderNodeKind.Component || node.Kind == BuilderNodeKind.Hook) {
                      return (
                        <VisualElement style={CanvasStyles.CardSection}>
                          <Label
                            text={node.Kind == BuilderNodeKind.Component || node.Kind == BuilderNodeKind.Hook ? "BODY — HOOKS & STATE" : "EXPORTS"}
                            style={CanvasStyles.CardSectionHeader}
                          />
                          <VisualElement
                            style={new Style {
                              FlexDirection = FlexRow,
                              FlexWrap = WrapOn,
                              MarginBottom = Px(2),
                            }}
                          >
                            @for (int x = 0; x < node.Body.Count; x++) {
                              int bx = x;
                              return (
                                <Label
                                  key={$"body-{x}"}
                                  text={node.Body[x].Kind == BuilderCardLineKind.Hook ? BuilderCanvasDrawing.ChipRichText(node.Body[x].Text) : node.Body[x].Text}
                                  enableRichText={true}
                                  onPointerDown={e => {
                                    if (e.ClickCount >= 2 && node.Body[bx].SourceLine > 0) {
                                      if (onRowClick != null) {
                                        onRowClick(node.FilePath, node.Body[bx].SourceLine);
                                      }
                                      e.StopPropagation();
                                    }
                                  }}
                                  onPointerEnter={e => { setTraceStates(BuilderCanvasDrawing.ChipStates(node.Body[bx].Text)); }}
                                  onPointerLeave={e => { setTraceStates((string)null); }}
                                  style={new Style {
                                    Color = BuilderCanvasDrawing.LineColor(node.Body[x].Kind),
                                    FontSize = Px(11.5f),
                                    BackgroundColor = Hex("#2a2a31"),
                                    BorderRadius = Px(10),
                                    BorderTopWidth = 1,
                                    BorderRightWidth = 1,
                                    BorderBottomWidth = 1,
                                    BorderLeftWidth = 1,
                                    BorderTopColor = Hex("#3a3a44"),
                                    BorderRightColor = Hex("#3a3a44"),
                                    BorderBottomColor = Hex("#3a3a44"),
                                    BorderLeftColor = Hex("#3a3a44"),
                                    PaddingLeft = Px(9),
                                    PaddingRight = Px(9),
                                    PaddingTop = Px(2),
                                    PaddingBottom = Px(2),
                                    MarginRight = Px(5),
                                    MarginBottom = Px(5),
                                  }}
                                />
                              );
                            }
                            @if (node.Kind == BuilderNodeKind.Component || node.Kind == BuilderNodeKind.Hook) {
                              return (
                                <Label
                                  text="+ hook"
                                  onPointerDown={e => {
                                    if (onAddHook != null) {
                                      onAddHook(node.FilePath);
                                    }
                                    e.StopPropagation();
                                  }}
                                  style={new Style {
                                    Color = Hex("#8b8b96"),
                                    FontSize = Px(11.5f),
                                    BorderRadius = Px(10),
                                    BorderTopWidth = 1,
                                    BorderRightWidth = 1,
                                    BorderBottomWidth = 1,
                                    BorderLeftWidth = 1,
                                    BorderTopColor = Hex("#3a3a44"),
                                    BorderRightColor = Hex("#3a3a44"),
                                    BorderBottomColor = Hex("#3a3a44"),
                                    BorderLeftColor = Hex("#3a3a44"),
                                    PaddingLeft = Px(9),
                                    PaddingRight = Px(9),
                                    PaddingTop = Px(2),
                                    PaddingBottom = Px(2),
                                    MarginBottom = Px(5),
                                  }}
                                />
                              );
                            }
                          </VisualElement>
                          @if (lod == 2 && node.IslandLines.Count > 0 && editKey == $"island:{index}") {
                            return (
                              <VisualElement style={new Style { MarginTop = Px(6) }}>
                                <TextField
                                  value={editText}
                                  multiline={true}
                                  onChange={ev => { setEditText(ev.newValue); }}
                                  style={new Style { MinHeight = Px(60) }}
                                />
                                <Label
                                  text="✓ commit"
                                  onPointerDown={e => {
                                    if (onIslandEdit != null) {
                                      onIslandEdit(node.FilePath, node.IslandStartLine, node.IslandEndLine, editText);
                                    }
                                    setEditKey("");
                                    e.StopPropagation();
                                  }}
                                  style={new Style { Color = Hex("#4fc3f7"), UnityFontStyle = FontBold, FontSize = Px(10) }}
                                />
                              </VisualElement>
                            );
                          }
                          @if (lod == 2 && node.IslandLines.Count > 0 && editKey != $"island:{index}") {
                            return (
                              <VisualElement
                                onPointerDown={e => {
                                  if (e.ClickCount >= 2 && node.IslandStartLine > 0) {
                                    setEditKey($"island:{index}");
                                    setEditText(string.Join("\n", node.IslandLines));
                                    e.StopPropagation();
                                  }
                                }}
                                style={new Style {
                                  BackgroundColor = Hex("#17171b"),
                                  BorderRadius = Px(6),
                                  BorderTopWidth = 1,
                                  BorderRightWidth = 1,
                                  BorderBottomWidth = 1,
                                  BorderLeftWidth = 1,
                                  BorderTopColor = Hex("#3a3a44"),
                                  BorderRightColor = Hex("#3a3a44"),
                                  BorderBottomColor = Hex("#3a3a44"),
                                  BorderLeftColor = Hex("#3a3a44"),
                                  PaddingLeft = Px(9),
                                  PaddingRight = Px(9),
                                  PaddingTop = Px(6),
                                  PaddingBottom = Px(6),
                                  MarginTop = Px(6),
                                }}
                              >
                                @for (int ci = 0; ci < node.IslandLines.Count; ci++) {
                                  return (
                                    <Label
                                      key={$"isl-{ci}"}
                                      text={node.IslandLines[ci]}
                                      style={new Style {
                                        Color = Hex("#bdbdc7"),
                                        FontSize = Px(11.5f),
                                      }}
                                    />
                                  );
                                }
                              </VisualElement>
                            );
                          }
                        </VisualElement>
                      );
                    }
                    @if (node.ExportDetail.Count > 0) {
                      return (
                        <VisualElement style={CanvasStyles.CardSection}>
                          <Label text="EXPORTS" style={CanvasStyles.CardSectionHeader} />
                          @for (int x = 0; x < node.ExportDetail.Count; x++) {
                            var detail = node.ExportDetail[x];
                            bool isAdd = detail.BadgeKind == 9 || detail.BadgeKind == 10 || detail.BadgeKind == 11;
                            bool editableLine = !isAdd
                              && detail.Text != "}"
                              && lod == 2;
                            string entryKey = $"entry:{index}:{x}";
                            bool detailVisible = detail.Kind == BuilderCardLineKind.Export
                              || detail.Text == "}"
                              || detail.BadgeKind == 10
                              || detail.BadgeKind == 11
                              || lod == 2;
                            return (
                              <VisualElement key={$"ed-{x}"}>
                                @if (detailVisible && editKey == entryKey) {
                                  return (
                                    <VisualElement style={new Style { FlexDirection = FlexRow, MarginLeft = Px(detail.Depth * 18f) }}>
                                      <TextField
                                        value={editText}
                                        onChange={ev => { setEditText(ev.newValue); }}
                                        style={new Style { FlexGrow = 1 }}
                                      />
                                      <Label
                                        text="✓"
                                        onPointerDown={e => {
                                          if (onLineRewrite != null) {
                                            onLineRewrite(node.FilePath, detail.SourceLine, editText);
                                          }
                                          setEditKey("");
                                          e.StopPropagation();
                                        }}
                                        style={new Style { Color = Hex("#4fc3f7"), UnityFontStyle = FontBold, PaddingLeft = Px(4) }}
                                      />
                                    </VisualElement>
                                  );
                                }
                                @if (detailVisible && editKey != entryKey) {
                                  return (
                                    <Label
                                      text={detail.Text}
                                      style={new Style {
                                        Color = isAdd
                                          ? Hex("#8b8b96")
                                          : detail.Kind == BuilderCardLineKind.Export
                                            ? Hex("#ce93d8")
                                            : Hex("#cfcfda"),
                                        FontSize = Px(12),
                                        UnityFontStyle = detail.Kind == BuilderCardLineKind.Export ? FontBold : FontNormal,
                                        MarginLeft = Px(detail.Depth * 18f),
                                      }}
                                      onPointerDown={e => {
                                        if (detail.BadgeKind == 9) {
                                          if (onStyleAddEntry != null) {
                                            onStyleAddEntry(node.FilePath, detail.AttrsText, detail.SourceLine);
                                          }
                                        } else if (detail.BadgeKind == 10) {
                                          if (onAddStyleExport != null) {
                                            onAddStyleExport(node.FilePath);
                                          }
                                        } else if (detail.BadgeKind == 11) {
                                          if (onAddUtilExport != null) {
                                            onAddUtilExport(node.FilePath);
                                          }
                                        } else if (editableLine) {
                                          setEditKey(entryKey);
                                          setEditText(detail.Text);
                                        } else if (onRowClick != null) {
                                          onRowClick(node.FilePath, detail.SourceLine);
                                        }
                                        e.StopPropagation();
                                      }}
                                    />
                                  );
                                }
                              </VisualElement>
                            );
                          }
                        </VisualElement>
                      );
                    }
                    @if (node.Markup.Count > 0) {
                      return (
                        <VisualElement style={CanvasStyles.CardSection}>
                          <Label text="RETURN — MARKUP" style={CanvasStyles.CardSectionHeader} />
                          @for (int x = 0; x < node.Markup.Count; x++) {
                            var row = node.Markup[x];
                            int rowIdx = x;
                            int rowKey = index * 1000 + rowIdx;
                            bool rowSel = selRowNode == index && selRowIdx == rowIdx;
                            bool rowHl = BuilderCanvasDrawing.RowMatchesTrace(row.AttrsText, traceStates);
                            bool dropHere = dragRowKey == rowKey;
                            return (
                              <VisualElement
                                key={$"mk-{x}"}
                                style={new Style {
                                  FlexDirection = FlexRow,
                                  AlignItems = AlignCenter,
                                  MarginLeft = Px(row.Depth * 14f),
                                  PaddingLeft = Px(6),
                                  PaddingRight = Px(6),
                                  PaddingTop = Px(2.5f),
                                  PaddingBottom = Px(2.5f),
                                  BorderRadius = Px(5),
                                  BackgroundColor = dropHere && dragBand == 1
                                    ? Rgba(79, 195, 247, 30)
                                    : rowSel
                                      ? Rgba(255, 213, 79, 38)
                                      : rowHl
                                        ? Rgba(255, 183, 77, 46)
                                        : hoverRowKey == rowKey
                                          ? Rgba(79, 195, 247, 20)
                                          : Rgba(0, 0, 0, 0),
                                  BorderTopWidth = dropHere && dragBand == 0 ? 2 : 0,
                                  BorderTopColor = Hex("#4fc3f7"),
                                  BorderBottomWidth = dropHere && dragBand == 2 ? 2 : 0,
                                  BorderBottomColor = Hex("#4fc3f7"),
                                }}
                                onPointerEnter={e => {
                                  if (hoverRowKey != rowKey) {
                                    setHoverRowKey(rowKey);
                                  }
                                }}
                                onPointerLeave={e => {
                                  if (hoverRowKey == rowKey) {
                                    setHoverRowKey(-1);
                                  }
                                }}
                                onPointerMove={e => {
                                  if (BuilderCanvasDrawing.DragActive) {
                                    setDragRowKey(rowKey);
                                    setDragBand(BuilderCanvasDrawing.DropBand(e));
                                    e.StopPropagation();
                                  }
                                }}
                                onPointerUp={e => {
                                  if (BuilderCanvasDrawing.DragActive && onRowDrop != null) {
                                    onRowDrop(node.FilePath, rowIdx, dragBand, BuilderDragService.Take());
                                    setDragRowKey(-1);
                                    e.StopPropagation();
                                  }
                                }}
                                onPointerDown={e => {
                                  if (e.Button == 1) {
                                    if (onRowContext != null) {
                                      onRowContext(node.FilePath, row.SourceLine, rowIdx);
                                    }
                                    e.StopPropagation();
                                    return;
                                  }
                                  if (e.ClickCount >= 2 && row.Kind == BuilderCardLineKind.Component) {
                                    if (onRowNavigate != null) {
                                      onRowNavigate(row.Text.Trim('<', '>'));
                                    }
                                    e.StopPropagation();
                                    return;
                                  }
                                  if (rowIdx > 0) {
                                    BuilderDragService.Arm($"move:{node.FilePath}:{rowIdx}");
                                  }
                                  setSelRowNode(index);
                                  setSelRowIdx(rowIdx);
                                  if (onRowClick != null) {
                                    onRowClick(node.FilePath, row.SourceLine);
                                  }
                                  e.StopPropagation();
                                }}
                              >
                                @if (row.BadgeKind > 0 && editKey == $"badge:{index}:{rowIdx}") {
                                  return (
                                    <VisualElement style={new Style { FlexDirection = FlexRow, FlexGrow = 1 }}>
                                      <TextField
                                        value={editText}
                                        onChange={ev => { setEditText(ev.newValue); }}
                                        style={new Style { FlexGrow = 1 }}
                                      />
                                      <Label
                                        text="✓"
                                        onPointerDown={e => {
                                          if (onDirectiveEdit != null) {
                                            onDirectiveEdit(node.FilePath, row.SourceLine, editText);
                                          }
                                          setEditKey("");
                                          e.StopPropagation();
                                        }}
                                        style={new Style { Color = Hex("#4fc3f7"), UnityFontStyle = FontBold, PaddingLeft = Px(4) }}
                                      />
                                    </VisualElement>
                                  );
                                }
                                @if (row.BadgeKind > 0 && editKey != $"badge:{index}:{rowIdx}") {
                                  return (
                                    <Label
                                      text={row.Text}
                                      onPointerDown={e => {
                                        if (lod == 2) {
                                          setEditKey($"badge:{index}:{rowIdx}");
                                          setEditText(row.Text);
                                          e.StopPropagation();
                                        }
                                      }}
                                      style={new Style {
                                        FontSize = Px(10),
                                        UnityFontStyle = FontBold,
                                        Color = BuilderCanvasDrawing.BadgeColor(row.BadgeKind),
                                        BackgroundColor = BuilderCanvasDrawing.BadgeBg(row.BadgeKind),
                                        BorderRadius = Px(7),
                                        PaddingLeft = Px(6),
                                        PaddingRight = Px(6),
                                        MarginRight = Px(6),
                                      }}
                                    />
                                  );
                                }
                                @if (row.BadgeKind == 0) {
                                  return (
                                    <Label
                                      text={row.Text}
                                      style={new Style {
                                        Color = BuilderCanvasDrawing.LineColor(row.Kind),
                                        FontSize = Px(12),
                                        UnityFontStyle = row.Kind == BuilderCardLineKind.Component ? FontBold : FontNormal,
                                      }}
                                    />
                                  );
                                }
                                @if (lod == 2 && row.BadgeKind == 0) {
                                  return (
                                    <VisualElement style={new Style { FlexDirection = FlexRow, FlexWrap = WrapOn, FlexShrink = 1 }}>
                                      @for (int ai = 0; ai < row.AttrPairs.Count; ai++) {
                                        int attrIdx = ai;
                                        string pair = row.AttrPairs[ai];
                                        int eq = pair.IndexOf('=');
                                        string attrName = eq < 0 ? pair : pair.Substring(0, eq);
                                        string attrValue = eq < 0 ? "" : pair.Substring(eq + 1);
                                        bool isExpr = attrValue.StartsWith("{");
                                        string innerValue = attrValue.Length >= 2 ? attrValue.Substring(1, attrValue.Length - 2) : "";
                                        string attrKey = $"attr:{index}:{rowIdx}:{ai}";
                                        return (
                                          <VisualElement key={attrKey} style={new Style { FlexDirection = FlexRow, MarginLeft = Px(6) }}>
                                            <Label
                                              text={attrName + "=" + (isExpr ? "{" : "\"")}
                                              style={new Style { Color = Hex("#9d9dab"), FontSize = Px(12) }}
                                            />
                                            @if (editKey == attrKey) {
                                              return (
                                                <VisualElement style={new Style { FlexDirection = FlexRow }}>
                                                  <TextField
                                                    value={editText}
                                                    onChange={ev => { setEditText(ev.newValue); }}
                                                    style={new Style { MinWidth = Px(60) }}
                                                  />
                                                  <Label
                                                    text="✓"
                                                    onPointerDown={e => {
                                                      if (onAttrValueEdit != null) {
                                                        onAttrValueEdit(node.FilePath, row.SourceLine, attrIdx, editText);
                                                      }
                                                      setEditKey("");
                                                      e.StopPropagation();
                                                    }}
                                                    style={new Style { Color = Hex("#4fc3f7"), UnityFontStyle = FontBold, PaddingLeft = Px(4) }}
                                                  />
                                                </VisualElement>
                                              );
                                            }
                                            @if (editKey != attrKey) {
                                              return (
                                                <Label
                                                  text={innerValue}
                                                  onPointerDown={e => {
                                                    setEditKey(attrKey);
                                                    setEditText(innerValue);
                                                    e.StopPropagation();
                                                  }}
                                                  style={new Style { Color = Hex("#ffb74d"), FontSize = Px(12) }}
                                                />
                                              );
                                            }
                                            <Label
                                              text={isExpr ? "}" : "\""}
                                              style={new Style { Color = Hex("#9d9dab"), FontSize = Px(12) }}
                                            />
                                          </VisualElement>
                                        );
                                      }
                                      @if (row.AttrPairs.Count == 0) {
                                        return (
                                          <Label
                                            text="+ attrs"
                                            onPointerDown={e => {
                                              if (onRowContext != null) {
                                                onRowContext(node.FilePath, row.SourceLine, rowIdx);
                                              }
                                              e.StopPropagation();
                                            }}
                                            style={new Style { Color = Hex("#8b8b96"), FontSize = Px(12), MarginLeft = Px(6) }}
                                          />
                                        );
                                      }
                                    </VisualElement>
                                  );
                                }
                                @if (row.Kind == BuilderCardLineKind.Component && row.BadgeKind == 0) {
                                  return (
                                    <VisualElement
                                      style={new Style {
                                        Width = Px(8),
                                        Height = Px(8),
                                        BorderRadius = Px(4),
                                        BackgroundColor = BuilderCanvasDrawing.DotColor(5),
                                        MarginLeft = Px(6),
                                        FlexShrink = 0,
                                      }}
                                    />
                                  );
                                }
                              </VisualElement>
                            );
                          }
                        </VisualElement>
                      );
                    }
                  </VisualElement>
                );
              }
            </VisualElement>
          );
        }
      </VisualElement>
    </VisualElement>
  );
}
