    <Compile Include="../Shared/Core/Diagnostics/DiagnosticsConfig.cs" Link="Linked/Diagnostics/DiagnosticsConfig.cs" />
    <Compile Include="../Shared/Elements/ElementRegistry.cs" Link="Linked/Elements/ElementRegistry.cs" />
    <Compile Include="../Shared/Elements/IElementAdapter.cs" Link="Linked/Elements/IElementAdapter.cs" />
    <Compile Include="../Shared/Props/Typed/ErrorBoundaryProps.cs" Link="Linked/Props/ErrorBoundaryProps.cs" />
