    <Compile Include="../Shared/Core/VNode.cs" Link="Linked/Core/VNode.cs" />
    <Compile Include="../Shared/Core/V.Core.cs" Link="Linked/Core/V.Core.cs" />
    <Compile Include="../Shared/Core/Hooks.cs" Link="Linked/Core/Hooks.cs" />
    <Compile Include="../Shared/Core/HookRegistry.cs" Link="Linked/Core/HookRegistry.cs" />
    <Compile Include="../Shared/Core/HookSignatureAttribute.cs" Link="Linked/Core/HookSignatureAttribute.cs" />
    <Compile Include="../Shared/Core/HostContext.cs" Link="Linked/Core/HostContext.cs" />
    <Compile Include="../Shared/Core/ReactiveTypes.cs" Link="Linked/Core/ReactiveTypes.cs" />
    <Compile Include="../Shared/Core/NodeMetadata.cs" Link="Linked/Core/NodeMetadata.cs" />
    <Compile Include="../Shared/Core/PropTypes.cs" Link="Linked/Core/PropTypes.cs" />
    <Compile Include="../Shared/Core/IProps.cs" Link="Linked/Core/IProps.cs" />
