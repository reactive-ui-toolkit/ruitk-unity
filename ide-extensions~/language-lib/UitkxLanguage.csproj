<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Ruitk.Language</RootNamespace>
    <AssemblyName>Ruitk.Language</AssemblyName>
    <!--
      RuitkEditorVariant=true builds the SAME sources as Ruitk.Language.Editor -
      the copy the RUITK Builder asmdef references normally. Distinct assembly
      identity is mandatory: the Analyzers/ copy is Assembly.LoadFrom'd by HMR
      and a same-identity second load is nondeterministic. Invoked only by
      scripts/build-generator.ps1 with redirected Base*OutputPath so the two
      flavors never share obj/.
    -->
    <AssemblyName Condition="'$(RuitkEditorVariant)' == 'true'">Ruitk.Language.Editor</AssemblyName>
    <!--
      Keep the sibling flavor's obj/bin out of the source glob: the variant
      build redirects its intermediates, and whichever flavor runs second
      would otherwise glob the other's generated AssemblyInfo (CS0579 storm).
      Set here (not via -p:) because global properties are immutable and
      would discard the SDK's own appended excludes.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      Define UNITY_EDITOR so the linked HookRegistry.cs (wrapped in
      #if UNITY_EDITOR to be stripped from Unity player builds) compiles
      into Ruitk.Language.dll.  The language library only runs in
      editor / LSP contexts, so this constant is unconditionally true here.
    -->
    <DefineConstants>$(DefineConstants);UNITY_EDITOR</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Single-source-of-truth hook metadata registry.  Linked from Shared/Core
      so the IDE diagnostics analyzer, LSP hover handler, and virtual-document
      generator share the same table as the Unity-side source generator.
    -->
    <Compile Include="..\..\Shared\Core\HookRegistry.cs" Link="HookRegistry.cs" />
  </ItemGroup>
  <ItemGroup>
    <!--
      System.Collections.Immutable is the only NuGet dependency.
      PrivateAssets="all" prevents it from flowing into the output folder —
      both Unity (via Roslyn 4.3.1) and the LSP server (via .NET 8) already
      ship an appropriate version of the assembly at runtime.
    -->
    <PackageReference Include="System.Collections.Immutable" Version="6.0.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
