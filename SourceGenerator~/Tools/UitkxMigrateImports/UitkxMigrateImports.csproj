<Project Sdk="Microsoft.NET.Sdk">

  <!--
    UitkxMigrateImports — the leg-3 migration codemod (plan §11).

    Rewrites existing .uitkx sources to the import/export grammar in place:
      • prepend `export` to every top-level declaration (export-everything default, A3);
      • insert `import { … } from "./relative"` lines for every referenced peer
        (fresh reference scan — component tags, useX() calls, Module. member access);
      • stamp the CURRENT effective @namespace so existing companion-.cs identity is frozen.

    Idempotent + re-runnable.

    The primary mode is now `--es-modules` (0.16.0 legacy-removal wave): rewrites legacy
    wrapper-keyword files (component/hook/module, companion partial-merging) to plain
    typed declarations with explicit imports and a namespace-move ledger; see Program.cs
    for the CLI contract and exit codes.

    Ships in the package as SOURCE (SourceGenerator~ is part of the published tree; the
    `~` suffix only hides it from Unity's asset importer). Users run it with the .NET 8
    SDK, or via scripts/migrate-uitkx.mjs in this repo. References the shared language lib.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>UitkxMigrateImports</AssemblyName>
    <RootNamespace>Ruitk.SourceGenerator.Tools</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\ide-extensions~\language-lib\UitkxLanguage.csproj" />
    <!-- ES-modules campaign (M7/U-09): the module-explosion pass parses legacy `module { … }`
         bodies (arbitrary C# class members) to hoist them into plain declarations. Version
         matches the SG's pin. Tool-only — never shipped to Unity. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.1" />
  </ItemGroup>

</Project>
